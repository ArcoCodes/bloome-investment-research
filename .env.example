# Required for the private beta research gateway in both Codex and Claude Code.
# Inject this through the host environment; never commit a real token.
RESEARCH_API_TOKEN=your-beta-token

# Optional. The plugin uses the Bloome beta gateway when this is omitted.
# RESEARCH_SEARCH_URL=https://your-research-gateway.example.com

# Optional Gildata Data Map MCP integration. Inject the real token through the
# host environment or ~/.bloome/gildata-mcp-token; never commit it.
GILDATA_MCP_TOKEN=your-gildata-token

# Optional overrides for enterprise deployments and custom credential paths.
# GILDATA_MCP_TOKEN_FILE=~/.bloome/gildata-mcp-token
# GILDATA_MCP_URL=https://api.gildata.com/mcp-servers/aidata-assistant-srv-tool
